# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts

# env — never commit real secrets, .env.example is the template
.env
.env.*
!.env.example

# logs & os noise
*.log
# pidfiles from the detached dev/preview servers (no systemd here)
*.pid
*.pid.log
.DS_Store

# screenshots dropped at the project root during a review pass
/*.jpg
/*.png

# typescript
*.tsbuildinfo

# temp output from src/data/validate.mjs
.validate-build/

# Payload uploads when it falls back to local disk storage (production uses
# Vercel Blob — see docs/deployment.md)
public/media/

# Vercel project link (`.vercel/` holds the project id; never commit it)
.vercel/

# vite build output for the Capacitor app (regenerated by npm run build)
apps/mobile/dist/
