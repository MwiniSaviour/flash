{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "github": {
    "silent": true
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/admin",
      "has": [
        { "type": "host", "value": "admin.flash.scalmint.com" }
      ]
    }
  ]
}
