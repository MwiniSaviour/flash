# Flash — environment
#
# Copy to .env.local for development. Every value below is optional: without
# them the app serves its seeded demo data and a demo session. The moment the
# real keys are present the same screens read from Supabase and Clerk instead —
# no screen changes shape.

# ---------------------------------------------------------------------------
# Supabase (PostgreSQL only - file storage is Cloudinary)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The server-only key. It bypasses Row Level Security, so it belongs on the
# server and nowhere else: never expose it to the browser, never commit it.
# Without it the server reads fall back to the demo fixtures.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Clerk (sessions and customer accounts)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Verifies Clerk webhooks (for example account updates). Optional.
CLERK_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Cloudinary (the only file storage)
#
# The cloud name is public and is inlined into the browser build. The API key
# and secret stay on the server and are never sent to the browser. Without the
# three values below, uploads are hidden and the seeded catalogue is used.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder for uploads. Each upload is scoped further to its owner.
CLOUDINARY_FOLDER=flash

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public origin, used for canonical URLs and OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
