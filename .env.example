# Flash — environment
#
# Copy to .env.local for development. Locally, absent keys keep the seeded demo
# session and catalogue; in production `assertProductionEnv()` fails fast when
# the database, Clerk or Cloudinary credentials are missing. No screen changes
# shape between the two — only the source of the rows does.

# ---------------------------------------------------------------------------
# Database API (VPS Postgres/PostgREST, exposed through an HTTPS reverse proxy)
# ---------------------------------------------------------------------------
# No Supabase cloud project is used. This is the Supabase-shaped REST endpoint:
# locally http://127.0.0.1:3002, in production https://db-api.flash.scalmint.com.
DATABASE_API_URL=

# The server-only signed JWT. It bypasses Row Level Security, so it belongs on
# the server and nowhere else: never expose it to the browser, never commit it.
# It is an HS256 token signed with the VPS PGRST_JWT_SECRET, carrying
# role="service_role". The browser has no database credential.
DATABASE_SERVICE_ROLE_KEY=

# Local JSON file with the five seller entries for scripts/create-sellers.mjs.
# It must never be committed. Only Clerk ids are printed by the script.
FLASH_SELLERS_FILE=

# ---------------------------------------------------------------------------
# Clerk (sessions and customer accounts)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Verifies Clerk webhooks (for example account updates). Optional.
CLERK_WEBHOOK_SECRET=
# Account screens are owned by Flash; these keep Clerk from using its hosted
# sign-in or account portal URLs.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------------------------------------------------------------------------
# Cloudinary (the only file storage)
#
# The cloud name is public and is inlined into the browser build. The API key
# and secret stay on the server and are never sent to the browser. Without the
# three values below, uploads are hidden and the seeded catalogue is used.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder for uploads. Each upload is scoped further to its owner.
CLOUDINARY_FOLDER=flash

# ---------------------------------------------------------------------------
# Paystack (Ghana)
#
# One secret key is enough: Flash uses Paystack's hosted checkout URL, so no
# browser-side public key is needed. The webhook secret verifies callbacks.
# Without these, checkout stays in demo mode and shows no provider.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Shared dispatch (rides and parcels)
#
# The engine lives in the ecommerce repo. DISPATCH_API_KEY is the per-product
# key the engine maps to an app id; DISPATCH_APP_ID is Flash's tenant id, stored
# with every job so a poll or a payout cannot land in another product's data.
# All three stay on the server. Without them the keyless demo still works.
# ---------------------------------------------------------------------------
DISPATCH_BASE_URL=
DISPATCH_API_KEY=
DISPATCH_APP_ID=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public origin, used for canonical URLs, OpenGraph metadata and the sitemap.
# Locally this defaults to http://localhost:3000. On Vercel, leave it unset to
# use the deployment host; set it to the final domain once one is attached.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Unified superadmin dashboard (hosted by ScalMart). /admin on this app
# redirects here with the Flash project selected.
NEXT_PUBLIC_SCALMART_ADMIN_URL=https://admin.scalmint.com/admin
# Where customers reach the support team from Help & Support. Leave unset to
# hide the support contact on that screen.
NEXT_PUBLIC_SUPPORT_EMAIL=support@flash.gh
# Place search/reverse geocoding. Defaults to Photon's public CDN; point at a
# self-hosted Photon instance once volume outgrows fair use.
NEXT_PUBLIC_GEOCODER_URL=https://photon.komoot.io
# Vector tile style streamed from a CDN. OpenFreeMap is free and key-free;
# swap to Mapbox/MapTiler later without changing the app.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# The host that serves the superadmin console in production. Requests for /admin
# on any other production host are refused; leave unset for local development.
ADMIN_HOST=admin.flash.scalmint.com

# ---------------------------------------------------------------------------
# Smart notifications
#
# Web push uses VAPID (generate a key pair with `web-push generate-vapid-keys`).
# Native push uses FCM HTTP v1 with a service-account JSON. Email uses Resend.
# Any missing group degrades to log-only; the app never breaks because of it.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@flash.gh
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# Set to 1 only for a mobile build that ships google-services.json and
# @capacitor/push-notifications; otherwise native token registration crashes.
NEXT_PUBLIC_NATIVE_PUSH=
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=

