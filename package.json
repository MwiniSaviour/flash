{
  "name": "flash",
  "version": "0.1.0",
  "private": true,
  "description": "Flash — tickets, rides and food in one app (UI/UX foundation).",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "db:seed": "node scripts/generate-seed.mjs",
    "db:schema": "node scripts/generate-schema.mjs",
    "db:check": "node scripts/check-sql.mjs",
    "mobile:build": "node scripts/build-mobile.mjs",
    "mobile:sync": "npm run mobile:build && cap sync android",
    "mobile:open": "cap open android",
    "media:check": "node scripts/check-media.mjs",
    "media:migrate": "node scripts/migrate-images.mjs",
    "media:check-migration": "node scripts/check-media-migration.mjs",
    "payments:check": "node scripts/check-payments.mjs",
    "events:check": "node scripts/check-events.mjs",
    "notifications:check": "node scripts/check-notifications.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/geolocation": "^8.2.5",
    "@clerk/nextjs": "^7.10.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "svix": "^2.10.0",
    "tailwind-merge": "^3.7.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
